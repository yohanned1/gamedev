/* returns true when the player chooses Quit */
static bool ScreenMenu(Game *g)
{
    DrawRectangleGradientV(0, 0, SCREEN_W, SCREEN_H, (Color){20, 30, 70, 255}, (Color){70, 40, 110, 255});

    for (int i = 0; i < 8; i++)
    {
        float yy = 80 + (float)((int)(GetTime() * 30 + i * 90) % 600);
        DrawCircle(90 + i * 120, (int)yy, 18, Fade((Color){255, 215, 0, 255}, 0.35f));
    }

    DrawCentered("BUDGET BATTLE", 90, 70, (Color){255, 220, 60, 255});
    DrawCentered("30 Days to Survive", 170, 30, WHITE);

    if (Button((Rectangle){350, 260, 300, 60}, "Start Game", true, false))
    {
        memset(&g->player, 0, sizeof(g->player));
        g->screen = SCREEN_CREATE;
    }
    if (Button((Rectangle){350, 340, 300, 60}, "Continue Game", true, false))
    {
        if (LoadGame(g))
        {
            g->screen = SCREEN_STORY;
            g->step = 0;
            g->shown = 0;
            g->showResult = false;
            g->npc[0] = '\0';
        }
        else
            Toast(g, "No saved game found.");
    }
    if (Button((Rectangle){350, 420, 300, 60}, "Quit Game", true, false))
        return true;

    DrawCentered("Click to play  |  Space / Enter to continue dialogue", SCREEN_H - 40, 18, Fade(WHITE, 0.6f));
    return false;
}

static void ScreenCreate(Game *g)
{
    DrawRectangleGradientV(0, 0, SCREEN_W, SCREEN_H, (Color){20, 30, 70, 255}, (Color){40, 70, 120, 255});
    DrawCentered("CHARACTER CREATION", 50, 44, WHITE);

    /* name input */
    DrawText("Enter your character's name:", 250, 140, 24, WHITE);
    Rectangle box = {250, 175, 500, 55};
    DrawRectangleRounded(box, 0.2f, 8, (Color){15, 20, 40, 255});
    DrawRectangleLinesEx(box, 2, WHITE);

    int len = (int)strlen(g->player.name);
    int key = GetCharPressed();
    while (key > 0)
    {
        if (key >= 32 && key <= 125 && len < MAX_NAME)
        {
            g->player.name[len++] = (char)key;
            g->player.name[len] = '\0';
        }
        key = GetCharPressed();
    }
    if (IsKeyPressed(KEY_BACKSPACE) && len > 0)
        g->player.name[--len] = '\0';

    DrawText(g->player.name, 265, 190, 28, WHITE);
    if (((int)(GetTime() * 2)) % 2 == 0)
        DrawText("_", 265 + MeasureText(g->player.name, 28), 190, 28, WHITE);

    /* gender */
    DrawText("Choose your gender:", 250, 265, 24, WHITE);
    if (Button((Rectangle){250, 305, 240, 55}, "Male", true, g->player.gender == 1))
        g->player.gender = 1;
    if (Button((Rectangle){510, 305, 240, 55}, "Female", true, g->player.gender == 2))
        g->player.gender = 2;

    /* preview */
    if (g->player.gender != 0)
    {
        bool fem = g->player.gender == 2;
        DrawCharacter(500, 560, fem ? (Color){220, 90, 150, 255} : (Color){60, 120, 220, 255},
                      (Color){40, 25, 15, 255}, fem, true);
    }

    bool ready = len > 0 && g->player.gender != 0;
    if (Button((Rectangle){250, 390, 240, 55}, "Back", true, false))
        g->screen = SCREEN_MENU;
    if (Button((Rectangle){510, 390, 240, 55}, "Start!", ready, false))
        StartNewGame(g);
}

static void ScreenStory(Game *g, float dt)
{
    const DayScript *d = &days[g->day];
    const Step *s = &d->steps[g->step];
    bool click = IsMouseButtonPressed(MOUSE_LEFT_BUTTON) || IsKeyPressed(KEY_SPACE) || IsKeyPressed(KEY_ENTER);

    if (s->type == STEP_SAY && IsNpc(s->speaker))
        snprintf(g->npc, sizeof(g->npc), "%s", s->speaker);

    DrawBackground(g->day);

    /* characters */
    bool fem = g->player.gender == 2;
    bool playerSpeaking = (s->type == STEP_SAY && strcmp(s->speaker, "Player") == 0);
    bool npcSpeaking = (s->type == STEP_SAY && IsNpc(s->speaker));

    DrawCharacter(240, 380, fem ? (Color){220, 90, 150, 255} : (Color){60, 120, 220, 255},
                  (Color){40, 25, 15, 255}, fem, playerSpeaking);
    if (g->npc[0])
    {
        Color shirt, hair;
        bool lh;
        NpcStyle(g->npc, &shirt, &hair, &lh);
        DrawCharacter(760, 380, shirt, hair, lh, npcSpeaking);
    }

    DrawHUD(g);

    char text[400], wrapped[512], buf[128];

    /* ---------- result panel after a choice ---------- */
    if (g->showResult)
    {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, Fade(BLACK, 0.6f));
        Rectangle panel = {150, 170, 700, 280};
        DrawRectangleRounded(panel, 0.08f, 8, (Color){25, 30, 55, 250});
        DrawRectangleLinesEx(panel, 3, (Color){255, 220, 60, 255});

        WrapText(g->resultMsg, wrapped, sizeof(wrapped), 640, 28);
        DrawText(wrapped, 180, 210, 28, WHITE);
        DrawText(g->resultStats, 180, 340, 22, (Color){255, 220, 60, 255});
        DrawText("Click to continue", 180, 400, 20, Fade(WHITE, 0.7f));

        if (click)
        {
            g->showResult = false;
            g->step++;
            g->shown = 0;
        }
        return;
    }

    switch (s->type)
    {
    case STEP_TITLE:
    case STEP_END:
    {
        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, Fade(BLACK, 0.8f));
        DrawCentered(s->text, 230, 52, WHITE);
        if (s->type == STEP_END)
        {
            snprintf(buf, sizeof(buf), "Money: PHP %d   Energy: %d/100   Happiness: %d/100",
                     g->player.money, g->player.energy, g->player.happiness);
            DrawCentered(buf, 320, 24, (Color){255, 220, 60, 255});
        }
        DrawCentered("Click to continue", 440, 22, Fade(WHITE, ((int)(GetTime() * 2) % 2) ? 0.9f : 0.4f));

        if (click)
        {
            if (s->type == STEP_TITLE)
            {
                g->step++;
                g->shown = 0;
            }
            else
            {
                g->day++;
                if (g->day >= DAYS_WRITTEN)
                {
                    g->day = DAYS_WRITTEN - 1;
                    g->screen = SCREEN_ENDING;
                }
                else
                    BeginDay(g);
            }
        }
        break;
    }

    case STEP_SAY:
    {
        ApplyName(s->text, g->player.name, text, sizeof(text));
        WrapText(text, wrapped, sizeof(wrapped), 910, 26);
        int total = (int)strlen(wrapped);

        /* dialogue box */
        Rectangle box = {20, 440, 960, 190};
        DrawRectangleRounded(box, 0.08f, 8, Fade(BLACK, 0.82f));
        DrawRectangleLinesEx(box, 3, WHITE);

        /* name tag */
        const char *who = strcmp(s->speaker, "Player") == 0 ? g->player.name : s->speaker;
        Color tagColor = (Color){90, 90, 100, 255};
        if (strcmp(s->speaker, "Player") == 0)
            tagColor = (Color){60, 120, 220, 255};
        else if (IsNpc(s->speaker))
        {
            Color hair;
            bool lh;
            NpcStyle(s->speaker, &tagColor, &hair, &lh);
        }
        int tw = MeasureText(who, 24) + 40;
        Rectangle tag = {40, 405, (float)tw, 38};
        DrawRectangleRounded(tag, 0.3f, 8, tagColor);
        DrawRectangleLinesEx(tag, 2, WHITE);
        DrawText(who, 60, 412, 24, WHITE);

        /* typewriter */
        g->shown += 70.0f * dt;
        if (g->shown > total)
            g->shown = (float)total;

        DrawText(TextSubtext(wrapped, 0, (int)g->shown), 45, 465, 26, WHITE);

        if (g->shown >= total && ((int)(GetTime() * 2)) % 2 == 0)
            DrawText("Click to continue >", SCREEN_W - 260, 600, 20, Fade(WHITE, 0.8f));

        if (click)
        {
            if (g->shown < total)
                g->shown = (float)total;
            else
            {
                g->step++;
                g->shown = 0;
            }
        }
        break;
    }

    case STEP_CHOICE:
    {
        const ChoiceDef *c = &choices[s->choiceId];

        DrawRectangle(0, 0, SCREEN_W, SCREEN_H, Fade(BLACK, 0.55f));
        Rectangle panel = {80, 60, 840, 520};
        DrawRectangleRounded(panel, 0.05f, 8, (Color){25, 30, 55, 245});
        DrawRectangleLinesEx(panel, 3, (Color){255, 220, 60, 255});

        DrawCentered(c->title, 80, 34, (Color){255, 220, 60, 255});

        WrapText(c->prompt, wrapped, sizeof(wrapped), 780, 24);
        DrawText(wrapped, 120, 130, 24, WHITE);

        if (c->infoLeft)
        {
            DrawRectangleRounded((Rectangle){120, 205, 370, 115}, 0.1f, 8, (Color){240, 235, 215, 255});
            DrawText(c->infoLeft, 135, 215, 20, BLACK);
        }
        if (c->infoRight)
        {
            DrawRectangleRounded((Rectangle){510, 205, 370, 115}, 0.1f, 8, (Color){215, 230, 240, 255});
            DrawText(c->infoRight, 525, 215, 20, BLACK);
        }

        for (int i = 0; i < c->count; i++)
        {
            snprintf(buf, sizeof(buf), "[%d] %s", i + 1, c->options[i]);
            bool affordable = (c->correct >= 0) || (g->player.money >= c->cost[i]);
            Rectangle r = {120, 340 + i * 68.0f, 760, 54};
            bool picked = Button(r, buf, affordable, false);
            if (affordable && IsKeyPressed(KEY_ONE + i))
                picked = true;
            if (picked)
            {
                ResolveChoice(g, c, i);
                break;
            }
        }
        break;
    }
    }
}

