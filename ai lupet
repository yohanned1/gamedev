static bool IsNpc(const char *name)
{
    return name[0] && strcmp(name, "Narrator") != 0 && strcmp(name, "Player") != 0;
}

static void NpcStyle(const char *name, Color *shirt, Color *hair, bool *longHair)
{
    *longHair = false;
    *hair = (Color){30, 30, 30, 255};
    *shirt = SKYBLUE;

    if (strcmp(name, "Jelo") == 0)
        *shirt = ORANGE;
    else if (strcmp(name, "Mika") == 0)
    {
        *shirt = (Color){170, 90, 200, 255};
        *hair = (Color){70, 35, 20, 255};
        *longHair = true;
    }
    else if (strcmp(name, "Sir Dante") == 0)
    {
        *shirt = (Color){60, 60, 70, 255};
        *hair = (Color){50, 50, 50, 255};
    }
    else if (strcmp(name, "Professor") == 0)
    {
        *shirt = (Color){120, 80, 50, 255};
        *hair = (Color){170, 170, 170, 255};
    }
}

