/* ------------------------------------------------------------------ */
/*  MAIN                                                               */
/* ------------------------------------------------------------------ */

int main(void)
{
    InitWindow(SCREEN_W, SCREEN_H, "Budget Battle");
    SetTargetFPS(60);

    Game g;
    memset(&g, 0, sizeof(g));
    g.screen = SCREEN_MENU;

    bool quit = false;
    while (!quit && !WindowShouldClose())
    {
        float dt = GetFrameTime();
        if (g.toastTimer > 0)
            g.toastTimer -= dt;

        BeginDrawing();
        ClearBackground(BLACK);

        switch (g.screen)
        {
        case SCREEN_MENU:
            quit = ScreenMenu(&g);
            break;
        case SCREEN_CREATE:
            ScreenCreate(&g);
            break;
        case SCREEN_STORY:
            ScreenStory(&g, dt);
            break;
        case SCREEN_ENDING:
            ScreenEnding(&g);
            break;
        }

        DrawToast(&g);
        EndDrawing();
    }

    CloseWindow();
    return 0;
}
