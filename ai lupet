    int happiness;
} Player;

typedef enum
{
    SCREEN_MENU,
    SCREEN_CREATE,
    SCREEN_STORY,
    SCREEN_ENDING
} GameScreen;

typedef enum
{
    STEP_TITLE,
    STEP_SAY,
    STEP_CHOICE,
    STEP_END
} StepType;

typedef struct
{
    StepType type;
    const char *speaker;
    const char *text;
    int choiceId;
} Step;

typedef struct
{
    const Step *steps;
    int count;
} DayScript;

/* A choice / mini-game screen */
typedef struct
{
    const char *title;
    const char *prompt;
    const char *infoLeft;  /* optional panels (receipt / tray) */
    const char *infoRight;
    int count;
    const char *options[MAX_CHOICES];

    /* correct == -1  -> every option has its own cost/effects (like breakfast) */
    int correct;
    int cost[MAX_CHOICES];
    int energy[MAX_CHOICES];
    int happy[MAX_CHOICES];
    const char *msg[MAX_CHOICES];

    /* correct >= 0   -> quiz style: right / wrong result */
    int goodE, goodH, badE, badH;
    const char *goodMsg;
    const char *badMsg;
} ChoiceDef;

typedef struct
{
    GameScreen screen;
    Player player;
    int day;   /* 0-based */
