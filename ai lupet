/* ------------------------------------------------------------------ */
/*  YOUR ORIGINAL GAME LOGIC (unchanged)                               */
/* ------------------------------------------------------------------ */

void updateMoney(struct Player *player, int amount)
{
    player->money += amount;
}

void updateEnergy(struct Player *player, int amount)
{
    player->energy += amount;
    if (player->energy > 100)
        player->energy = 100;
    if (player->energy < 0)
        player->energy = 0;
}

void updateHappiness(struct Player *player, int amount)
{
    player->happiness += amount;
    if (player->happiness > 100)
        player->happiness = 100;
    if (player->happiness < 0)
        player->happiness = 0;
}

int spendMoney(struct Player *player, int amount)
{
    if (amount <= 0)
        return 0;
    if (player->money < amount)
        return 0;
    player->money -= amount;
    return 1;
}

/* ------------------------------------------------------------------ */
/*  SAVE / LOAD                                                        */
/* ------------------------------------------------------------------ */

static void SaveGame(const Game *g)
{
    FILE *f = fopen(SAVE_FILE, "wb");
    if (!f)
        return;
    SaveData d;
    d.player = g->player;
    d.day = g->day;
    fwrite(&d, sizeof(d), 1, f);
    fclose(f);
}

static bool LoadGame(Game *g)
{
    FILE *f = fopen(SAVE_FILE, "rb");
    if (!f)
        return false;
    SaveData d;
    size_t n = fread(&d, sizeof(d), 1, f);
    fclose(f);
    if (n != 1 || d.day < 0 || d.day >= DAYS_WRITTEN)
        return false;
    g->player = d.player;
    g->day = d.day;
    return true;
}

