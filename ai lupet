    DrawRectangle(265, 13, 150, 18, (Color){60, 60, 60, 255});
    DrawRectangle(265, 13, (int)(150 * p->energy / 100.0f), 18, (Color){80, 200, 100, 255});
    DrawRectangleLines(265, 13, 150, 18, WHITE);

    DrawText("Happy", 440, 11, 20, WHITE);
    DrawRectangle(505, 13, 150, 18, (Color){60, 60, 60, 255});
    DrawRectangle(505, 13, (int)(150 * p->happiness / 100.0f), 18, (Color){255, 130, 180, 255});
