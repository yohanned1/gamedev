static void BeginDay(Game *g)
{
    g->step = 0;
    g->shown = 0;
    g->showResult = false;
    g->npc[0] = '\0';
    SaveGame(g);
}

static void StartNewGame(Game *g)
{
    g->player.money = STARTING_MONEY;
    g->player.energy = 100;
    g->player.happiness = 100;
    g->day = 0;
    g->screen = SCREEN_STORY;
    BeginDay(g);
}

static void ResolveChoice(Game *g, const ChoiceDef *c, int pick)
{
    Player *p = &g->player;
    int m0 = p->money, e0 = p->energy, h0 = p->happiness;
    const char *msg;

    if (c->correct < 0)
    {
        spendMoney(p, c->cost[pick]);
        updateEnergy(p, c->energy[pick]);
        updateHappiness(p, c->happy[pick]);
        msg = c->msg[pick];
    }
    else if (pick == c->correct)
    {
        updateEnergy(p, c->goodE);
        updateHappiness(p, c->goodH);
        msg = c->goodMsg;
    }
    else
    {
        updateEnergy(p, c->badE);
        updateHappiness(p, c->badH);
        msg = c->badMsg;
    }

    snprintf(g->resultMsg, sizeof(g->resultMsg), "%s", msg);
    snprintf(g->resultStats, sizeof(g->resultStats), "Money %+d     Energy %+d     Happiness %+d",
             p->money - m0, p->energy - e0, p->happiness - h0);
    g->showResult = true;
}

