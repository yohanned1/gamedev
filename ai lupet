/*
 * BUDGET BATTLE - raylib story mode (click to play)
 *
 * Build (Windows / MinGW):
 *   gcc main.c -o BudgetBattle.exe -lraylib -lopengl32 -lgdi32 -lwinmm
 * Build (Linux):
 *   gcc main.c -o BudgetBattle -lraylib -lGL -lm -lpthread -ldl -lrt -lX11
 * Build (macOS):
 *   gcc main.c -o BudgetBattle -lraylib -framework OpenGL -framework Cocoa -framework IOKit
 *
 * Controls: Left click / Space / Enter = continue, click buttons or press 1-4 to choose.
 *
 * HOW TO ADD STORY: add lines to a day array (SAY / ASK / TITLE / DONE macros),
 * add a ChoiceDef to the `choices` table for new mini-games, then add the day
 * to the `days` table and raise DAYS_WRITTEN.
 */

