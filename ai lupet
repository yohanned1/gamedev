static bool Button(Rectangle r, const char *label, bool enabled, bool selected)
{
    Vector2 m = GetMousePosition();
    bool hover = enabled && CheckCollisionPointRec(m, r);

    Color bg = (Color){45, 60, 110, 255};
    if (!enabled)
        bg = (Color){70, 70, 70, 255};
    else if (selected)
        bg = (Color){60, 140, 90, 255};
    else if (hover)
        bg = (Color){80, 120, 200, 255};

    DrawRectangleRounded(r, 0.25f, 8, bg);
    DrawRectangleLinesEx(r, 2, (hover || selected) ? WHITE : (Color){150, 160, 200, 255});

    int fs = 24;
    int tw = MeasureText(label, fs);
    DrawText(label, (int)(r.x + (r.width - tw) / 2), (int)(r.y + (r.height - fs) / 2), fs,
             enabled ? WHITE : GRAY);

    return hover && IsMouseButtonPressed(MOUSE_LEFT_BUTTON);
}

static void DrawCentered(const char *text, int y, int size, Color c)
{
    DrawText(text, (SCREEN_W - MeasureText(text, size)) / 2, y, size, c);
}

static void Toast(Game *g, const char *msg)
{
    snprintf(g->toast, sizeof(g->toast), "%s", msg);
    g->toastTimer = 2.0f;
}

static void DrawToast(const Game *g)
{
    if (g->toastTimer <= 0)
        return;
    int w = MeasureText(g->toast, 22) + 40;
    Rectangle r = {(SCREEN_W - w) / 2.0f, SCREEN_H - 70, (float)w, 44};
    DrawRectangleRounded(r, 0.4f, 8, Fade(BLACK, 0.85f));
    DrawText(g->toast, (int)r.x + 20, (int)r.y + 11, 22, WHITE);
}

/* Wrap text to a pixel width by inserting '\n' */
static void WrapText(const char *src, char *out, int outSize, int maxWidth, int fontSize)
{
    char line[320] = {0};
    int outLen = 0;
    const char *p = src;
    out[0] = '\0';

    while (*p)
    {
        char word[64];
        int wl = 0;
        while (*p == ' ')
            p++;
        while (*p && *p != ' ' && wl < 63)
            word[wl++] = *p++;
        word[wl] = '\0';
        if (wl == 0)
            break;

        char test[400];
        if (line[0])
            snprintf(test, sizeof(test), "%s %s", line, word);
        else
            snprintf(test, sizeof(test), "%s", word);

        if (line[0] && MeasureText(test, fontSize) > maxWidth)
        {
            if (outLen >= outSize - 2)
                break;
            outLen += snprintf(out + outLen, outSize - outLen, "%s\n", line);
            snprintf(line, sizeof(line), "%s", word);
        }
        else
        {
            snprintf(line, sizeof(line), "%s", test);
        }
    }
    if (outLen < outSize)
        snprintf(out + outLen, outSize - outLen, "%s", line);
}

/* Replace {name} with the player's name */
static void ApplyName(const char *src, const char *name, char *out, int outSize)
{
    int o = 0;
    while (*src && o < outSize - 1)
    {
        if (strncmp(src, "{name}", 6) == 0)
        {
            for (const char *n = name; *n && o < outSize - 1; n++)
                out[o++] = *n;
            src += 6;
        }
        else
        {
            out[o++] = *src++;
        }
    }
    out[o] = '\0';
}

