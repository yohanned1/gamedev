// --- Fixed Custom UI Helper ---
bool DrawMenuButton(int x, int y, int width, int height, const char* text) {
    Vector2 mousePos = GetMousePosition();
    bool isHovered = (mousePos.x >= x && mousePos.x <= x + width && mousePos.y >= y && mousePos.y <= y + height);
    
    // Draw the button background box cleanly
    DrawRectangle(x, y, width, height, isHovered ? MAROON : DARKGRAY);
    DrawRectangleLines(x, y, width, height, WHITE);
    
    // FIXED TEXT ALIGNMENT: 
    // Measures the exact width of your current text array to center it inside your button dimensions dynamically
    int textWidth = MeasureText(text, 18); // Sized slightly down to 18 so it fits without overflowing
    DrawText(text, x + (width - textWidth) / 2, y + (height - 18) / 2, 18, WHITE);
    
    return isHovered && IsMouseButtonPressed(MOUSE_BUTTON_LEFT);
}


int main() {
    // Initialize Raylib window
    InitWindow(1200, 700, "Budget Battle");
    SetTargetFPS(60);

    struct Player player = { "", 0, 0, 100, 100 };
    
    // Menu system tracking states
    // 0 = Main Menu, 1 = Name Input, 2 = Gender Choice, 3 = Running Game, 4 = Saved Game Screen
    int menuState = 0; 
    int letterCount = 0;

    // Main window runtime loop
        // Main window runtime loop
    while (!WindowShouldClose()) {
        
        // --- RENDER PIPELINE ---
        BeginDrawing();
        ClearBackground(GOLD);

        switch (menuState) {
            case 0: // [MAIN MENU]
                int titleWidth1 = MeasureText("========================", 20);
                int titleWidth2 = MeasureText("Budget Battle", 45); 
                int titleWidth3 = MeasureText("30 Days to survive", 22);
                int menuWidth   = MeasureText("MAIN MENU", 24);

                DrawText("========================", (1200 - titleWidth1) / 2, 100, 20, WHITE);
                DrawText("Budget Battle", (1200 - titleWidth2) / 2, 135, 45, MAROON);
                DrawText("30 Days to survive", (1200 - titleWidth3) / 2, 190, 22, GRAY);
                DrawText("========================", (1200 - titleWidth1) / 2, 225, 20, WHITE);
                DrawText("MAIN MENU", (1200 - menuWidth) / 2, 280, 24, GOLD);

                if (DrawMenuButton(475, 340, 250, 50, "1. Start Game")) {
                    memset(player.name, 0, sizeof(player.name));
                    letterCount = 0;
                    menuState = 1; 
                }
                if (DrawMenuButton(475, 410, 250, 50, "2. Continue Game")) {
                    menuState = 4;
                }
                if (DrawMenuButton(475, 480, 250, 50, "3. Quit Game")) {
                    CloseWindow();
                    return 0;
                }
                break;

            case 1: // [CHARACTER CREATION - NAME]
                int titleWidth4 = MeasureText("================================", 20);
                int titleWidth5 = MeasureText("CHARACTER CREATION", 20); 
                int titleWidth6 = MeasureText("Enter your character's name:", 22);
                
                DrawText("================================", (1200 - titleWidth4) / 2, 80, 20, WHITE);
                DrawText("CHARACTER CREATION", (1200 - titleWidth5) / 2, 110, 24, MAROON);
                DrawText("================================", (1200 - titleWidth4) / 2, 140, 20, WHITE);
                DrawText("Enter your character's name:", (1200 - titleWidth6) / 2, 200, 20, WHITE);

                int key = GetCharPressed();
                while (key > 0) {
                    if ((key >= 32) && (key <= 125) && (letterCount < 49)) {
                        player.name[letterCount] = (char)key;
                        player.name[letterCount+1] = '\0';
                        letterCount++;
                    }
                    key = GetCharPressed();
                }
                if (IsKeyPressed(KEY_BACKSPACE) && letterCount > 0) {
                    letterCount--;
                    player.name[letterCount] = '\0';
                }

                DrawRectangle((1200 - 300) / 2, 240, 300, 50, LIGHTGRAY);
                DrawRectangleLines((1200 - 300) / 2, 240, 300, 50, WHITE);
                DrawText(player.name, (1200 - 300) / 2 + 15, 255, 20, BLACK);

                DrawText("Press ENTER to save your name", (1200 - 300) / 2, 320, 16, GRAY);
                if (IsKeyPressed(KEY_ENTER) && letterCount > 0) {
                    menuState = 2; 
                }
                break;

            case 2: // [CHARACTER CREATION - GENDER]
                DrawText("Choose your gender:", (1200 - 200) / 2, 180, 22, WHITE);

                if (DrawMenuButton((1200 - 200) / 2, 240, 200, 45, " Male")) {
                    player.gender = 1;
                    menuState = 3; 
                }
                if (DrawMenuButton((1200 - 200) / 2, 300, 200, 45, " Female")) {
                    player.gender = 2;
                    menuState = 3; 
                }
                break;

            case 3: // [ACTIVE RUNNING GAMEPLAY]
                // Setting menuState to an unused number breaks out of this while loop cleanly!
                menuState = 99; 
                break;

            case 4: // [CONTINUE SCREEN]
                DrawText("Checking saved game...", (1200 - 200) / 2, 200, 20, RED);
                if (DrawMenuButton((1200 - 200) / 2, 300, 200, 45, "Back to Menu")) {
                    menuState = 0;
                }
                break;
        }

        EndDrawing();
        
        // If we transitioned to state 99, exit the menu frame loop entirely!
        if (menuState == 99) {
            break;
        }
    }

    // --- GAME ENGINE HANDOFF ---
    // Now that the menu loops are finished, initialize core configurations and start your gameplay story safely!
    if (!WindowShouldClose() && (player.gender == 1 || player.gender == 2)) {
        player.money = 200;
        player.energy = 100;
        player.happiness = 100;
        printf("\nWelcome to Budget Battle, %s!\n", player.name);

        startGame(&player); 
    }

    CloseWindow();
    return 0;
}


// --- Your Game Functions Restored and Fixed ---
void displayStatus(struct Player player) {
    DrawRectangle(0, 0, 1250, 60, DARKGRAY);
    DrawRectangleLines(0, 0, 1250, 60, MAROON);

    char moneyText[50];
    char energyText[50];
    char happyText[50];
    
    sprintf(moneyText, "Money: PHP %d", player.money);
    sprintf(energyText, "Energy: %d/100", player.energy);
    sprintf(happyText, "Happiness: %d/100", player.happiness);

    DrawText(moneyText, 1200 / 4 - MeasureText(moneyText, 18) / 2, 20, 18, GREEN);
    DrawText(energyText, 1200 / 2 - MeasureText(energyText, 18) / 2, 20, 18, ORANGE);
    DrawText(happyText, 1200 * 3 / 4 - MeasureText(happyText, 18) / 2, 20, 18, PINK);
}

void updateMoney(struct Player *player, int amount) {
    player->money += amount;
}

void updateEnergy(struct Player *player, int amount) {
    player->energy += amount;
    if (player->energy > 100) player->energy = 100;
    if (player->energy < 0) player->energy = 0;
}

void updateHappiness(struct Player *player, int amount) {
    player->happiness += amount;
    if (player->happiness > 100) player->happiness = 100;
    if (player->happiness < 0) player->happiness = 0;
}

int spendMoney(struct Player *player, int amount) {
    if (amount <= 0 || player->money < amount) return 0;
    player->money -= amount;
    return 1;
}

void startGame(struct Player *player)
{
    for (int day = 1; day <= 30; day++)
    {
        printf("\n========== DAY %d ==========\n", day);

        displayStatus(*player);

        if (day == 1)
        {
            day1Story(player);
        }

        if (day == 2)
        {
            day2Story(player);
        }

        if (day == 3)
        {
            day3Story(player);
        }

        if (day == 4)
        {
            day4Story(player);
        }

        if (day == 5)
        {
            day5Story(player);
        }

        printf("\nPress Enter to continue...");
        getchar();
        getchar();
    }

    printf("\nCongratulations! You completed 30 days!\n");
}



