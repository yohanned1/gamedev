void showDialogue(const char speaker[], const char dialogue[]) {
    // 1. Safety check: Wait until the player releases ENTER from the previous choice
    while (IsKeyDown(KEY_ENTER)) {
        PollInputEvents(); 
        if (WindowShouldClose()) {
            CloseWindow();
            exit(0);
        }
    }

    // 2. Loop until they press ENTER down again
    while (!IsKeyPressed(KEY_ENTER)) {
        if (WindowShouldClose()) {
            CloseWindow();
            exit(0);
        }


        BeginDrawing();
        // FIXED: This stops old text from bleeding through or overlapping!
        ClearBackground(GOLD); 

        // Optional: Keep your stats dashboard visible during regular dialogue text segments
        // displayStatus(*player); 

        // --- DIALOGUE UI LAYOUT ---
        DrawRectangle(50, 480, 1100, 180, Fade(BLACK, 0.85f)); 
        DrawRectangleLines(50, 480, 1100, 180, WHITE);

        // Render dialogue elements
        DrawText(speaker, 80, 505, 24, GOLD);
        DrawText(dialogue, 80, 550, 20, WHITE);
        DrawText("[Press ENTER to continue]", 900, 625, 14, LIGHTGRAY);
        
        EndDrawing();
    }
}




void breakfastChoice(struct Player *player)
{
    int choice = 0; 
    bool choiceMade = false;
    
    int des2 = MeasureText("==================================", 20);
    int bftest = MeasureText("BREAKFAST TIME", 45); 
    int menuWidth = MeasureText("Bro gutom na ko, ano'ng trip mong breakfast?", 24);

    // Keep loop active until a choice is selected and confirmed
    while (!choiceMade) {
        if (WindowShouldClose()) {
            CloseWindow();
            exit(0);
        }

        BeginDrawing();
        ClearBackground(DARKGRAY); 

        // Always show the player stats at the top
        displayStatus(*player); 

        DrawText("==================================", (1200 - des2) / 2, 120, 20, WHITE);
        DrawText("BREAKFAST TIME", (1200 - bftest) / 2, 155, 45, MAROON);
        DrawText("==================================", (1200 - des2) / 2, 245, 20, WHITE);
        DrawText("Bro gutom na ko, ano'ng trip mong breakfast?", (1200 - menuWidth) / 2, 300, 24, GOLD);

        // Check button inputs. Once clicked, change stats ONCE and flip choiceMade to true to exit!
        if (DrawMenuButton(425, 360, 350, 50, "Carinderia meal - PHP 50") && spendMoney(player, 50)) {
            updateEnergy(player, 25);
            updateHappiness(player, 10);
            choiceMade = true;
        }
        if (DrawMenuButton(425, 430, 350, 50, "Fast-food meal - PHP 120") && spendMoney(player, 120)) { 
            updateEnergy(player, 40);
            updateHappiness(player, 20);
            choiceMade = true;
        }
        
        if (DrawMenuButton(425, 500, 350, 50, "Skip breakfast - PHP 0")) {
            updateEnergy(player, -15);
            updateHappiness(player, -10);
            choiceMade = true;
        }
        
        EndDrawing();
    }
    
    // Safety check: Wait for the user to lift their finger off the mouse button 
    // so it doesn't accidentally trigger input bugs in the next dialogue box
    while(IsMouseButtonDown(MOUSE_BUTTON_LEFT)) {
        PollInputEvents();
    }
}




